package layout

import (
	"github.com/kiban-cloud/go-kiban-design-system/view/icons"
)

templ Topbar(cfg Config) {
	<header class="h-14 border-b border-kiban-border bg-white flex items-center gap-4 px-4 shrink-0">
		<button
			type="button"
			data-sidebar-show-tools
			data-tooltip="Mostrar herramientas"
			aria-label="Mostrar herramientas"
			class="w-9 h-9 flex items-center justify-center text-kiban-ink3 hover:text-kiban-ink hover:bg-kiban-surface rounded-md"
		>
			@icons.Hamburger()
		</button>
		<a href={ templ.URL(cfg.ShellURL) } class="flex items-center gap-1 pr-4 border-r border-kiban-border h-full">
			<span class="font-heading font-bold text-xl text-kiban-ink">kiban</span>
			<span class="font-heading font-normal text-xl text-kiban-primary">cloud</span>
		</a>
		@spaceSwitcher(cfg)
		<div class="flex-1"></div>
		if cfg.SandboxToggle != nil {
			@sandboxSwitch(*cfg.SandboxToggle)
		}
		if cfg.DevelopersURL != "" {
			<a href={ templ.URL(cfg.DevelopersURL) } class="bg-kiban-primary text-white font-medium text-sm px-4 py-2 rounded-md hover:opacity-90">
				Developers
			</a>
		}
		<div class="h-8 w-px bg-kiban-border"></div>
		@topbarUserMenu(cfg)
	</header>
}

// sandboxSwitch renders the topbar's prod/sandbox switch as a styled
// anchor. The whole control is one navigation: clicking it goes to
// ToggleHref (the caller-computed URL with sandbox flipped) — no JS, no
// HTMX, no state to reconcile. The visual is a label + a switch track:
// filled in kiban-primary when Enabled, neutral when not.
//
// data-nav-loader makes the full-screen nav overlay (base.templ) appear on
// click, since flipping sandbox/prod triggers a full page reload that can
// take a moment.
templ sandboxSwitch(t SandboxToggle) {
	<a
		href={ templ.URL(t.ToggleHref) }
		data-nav-loader
		role="switch"
		aria-checked={ sandboxAriaChecked(t.Enabled) }
		title={ t.LabelOrDefault() }
		class="flex items-center gap-2 px-2 py-1 text-sm rounded-md hover:bg-kiban-surface select-none"
	>
		<span class="text-kiban-ink3">{ t.LabelOrDefault() }</span>
		<span class={ sandboxTrackClass(t.Enabled) }>
			<span class={ sandboxThumbClass(t.Enabled) }></span>
		</span>
	</a>
}

func sandboxAriaChecked(enabled bool) string {
	if enabled {
		return "true"
	}
	return "false"
}

// sandboxTrackClass returns the outer pill classes. Track color flips on
// state; size/shape stays constant so the thumb animation lines up.
func sandboxTrackClass(enabled bool) string {
	base := "relative inline-block w-9 h-5 rounded-full transition-colors"
	if enabled {
		return base + " bg-kiban-primary"
	}
	return base + " bg-kiban-border"
}

// sandboxThumbClass returns the inner circle classes. Position flips with
// state; transition handles the slide affordance even though the page
// itself is doing a full nav (looks crisp on hover/focus before click).
func sandboxThumbClass(enabled bool) string {
	base := "absolute top-0.5 w-4 h-4 rounded-full bg-white shadow-sm transition-all"
	if enabled {
		return base + " left-4"
	}
	return base + " left-0.5"
}

// topbarUserMenu is the avatar dropdown on the customer-facing Layout's
// topbar. Uses the same click-driven, outside-click-aware pattern as
// AdminLayout's adminUserMenu (via window.kibanToggleMenu / kibanCloseMenu
// in base.templ). The earlier `group-hover:block` approach was unusable
// because the small gap between trigger and panel (mt-1) broke the
// :hover chain and the menu closed before the user could reach
// "Cerrar sesión".
//
// ID prefix "topbar-user-menu" is kept distinct from "admin-user-menu"
// so a page that somehow renders both shells doesn't collide.
templ topbarUserMenu(cfg Config) {
	<div class="relative inline-block" data-kiban-menu="topbar-user-menu">
		<button
			type="button"
			id="topbar-user-menu-trigger"
			aria-haspopup="true"
			aria-expanded="false"
			aria-controls="topbar-user-menu-panel"
			aria-label={ "Menú de " + topbarUserMenuLabel(cfg.User) }
			onclick="window.kibanToggleMenu('topbar-user-menu')"
			class="w-9 h-9 rounded-full bg-kiban-surface border border-kiban-border text-kiban-ink3 text-sm font-medium flex items-center justify-center overflow-hidden hover:bg-kiban-border transition-colors"
		>
			{ userInitials(cfg.User) }
		</button>
		<div
			id="topbar-user-menu-panel"
			role="menu"
			aria-labelledby="topbar-user-menu-trigger"
			class="hidden absolute right-0 top-full mt-1 z-50 min-w-[220px] bg-white border border-kiban-border rounded-md shadow-lg py-1"
		>
			<div class="px-3 py-2 border-b border-kiban-border">
				if cfg.User.Name != "" {
					<div class="text-sm font-medium text-kiban-ink truncate">{ cfg.User.Name }</div>
				}
				<div class="text-xs text-kiban-ink4 truncate">{ cfg.User.Email }</div>
			</div>
			for _, item := range cfg.UserMenuItems {
				<a
					href={ templ.URL(item.Href) }
					role="menuitem"
					class="block px-3 py-2 text-sm hover:bg-kiban-surface text-kiban-ink"
					onclick="window.kibanCloseMenu('topbar-user-menu')"
				>
					{ item.Label }
				</a>
			}
			<form method="POST" action={ templ.URL(cfg.LogoutAction) }>
				<button
					type="submit"
					role="menuitem"
					class="w-full text-left px-3 py-2 text-sm hover:bg-kiban-surface text-kiban-ink"
					onclick="window.kibanCloseMenu('topbar-user-menu')"
				>
					Salir
				</button>
			</form>
		</div>
	</div>
}

// topbarUserMenuLabel returns the screen-reader label for the avatar
// trigger — prefers Name, falls back to Email, falls back to a generic
// "usuario" so the aria-label is never empty.
func topbarUserMenuLabel(u User) string {
	if u.Name != "" {
		return u.Name
	}
	if u.Email != "" {
		return u.Email
	}
	return "usuario"
}

templ IconRail(cfg Config) {
	<nav class="w-56 shrink-0 bg-white border-r border-kiban-border flex flex-col py-3 px-2 gap-1">
		for _, t := range cfg.Tools {
			@toolIcon(cfg, t)
		}
		<div class="flex-1"></div>
		for _, t := range cfg.Docs {
			@toolIcon(cfg, t)
		}
	</nav>
}

templ toolIcon(cfg Config, t Tool) {
	<a
		href={ templ.URL(t.Href) }
		data-nav-loader
		aria-label={ t.Label }
		class={
			"flex items-center gap-3 px-3 py-2 rounded-md transition-colors text-sm",
			templ.KV("bg-kiban-primary-soft text-kiban-primary font-medium", cfg.ToolKey == t.Key),
			templ.KV("text-kiban-ink hover:bg-kiban-surface", cfg.ToolKey != t.Key),
		}
	>
		<span class="w-5 h-5 flex-shrink-0 flex items-center justify-center">
			@t.Icon()
		</span>
		<span class="truncate">{ t.Label }</span>
	</a>
}

templ SubNav(cfg Config) {
	<nav data-sidebar-subnav class="w-56 shrink-0 bg-white border-r border-kiban-border p-3">
		<div class="text-xs text-kiban-ink4 px-3 py-2 font-medium">{ cfg.SectionLabel }</div>
		for _, item := range cfg.SubItems {
			@subItem(cfg, item)
		}
	</nav>
}

templ subItem(cfg Config, item SubItem) {
	<a
		href={ templ.URL(item.Href) }
		class={
			"block px-3 py-2 rounded-md text-sm transition-colors",
			templ.KV("bg-kiban-primary-soft text-kiban-primary font-medium", cfg.ActiveKey == item.Key),
			templ.KV("text-kiban-ink hover:bg-kiban-surface", cfg.ActiveKey != item.Key),
		}
	>
		{ item.Label }
	</a>
}

// spaceSwitcher renders the space chip in the topbar. Three states:
//
//   - No space active (cfg.SpaceID == "" or no CurrentSpaceName)
//     → "—" sentinel, no chevron, not clickable.
//   - One space available (len(cfg.Spaces) <= 1) or no SwitchSpaceAction
//     → readonly chip showing the current space's name, no chevron.
//   - 2+ spaces available + SwitchSpaceAction set
//     → clickable dropdown using kibanToggleMenu; each item is a tiny
//     POST form that submits the chosen spaceId so the consuming
//     project can validate access + set the cookie.
//
// The data-kiban-menu attribute ties the trigger and panel into the
// shared outside-click handler in base.templ — same plumbing as the
// avatar dropdown and the kebab menus.
templ spaceSwitcher(cfg Config) {
	if isSpaceSwitcherInteractive(cfg) {
		<div class="relative inline-block" data-kiban-menu="topbar-space-switcher">
			<button
				type="button"
				id="topbar-space-switcher-trigger"
				aria-haspopup="true"
				aria-expanded="false"
				aria-controls="topbar-space-switcher-panel"
				aria-label={ "Cambiar espacio (actual: " + spaceChipLabel(cfg) + ")" }
				onclick="window.kibanToggleMenu('topbar-space-switcher')"
				class="flex items-center gap-2 px-4 py-2 border border-kiban-border rounded-md text-sm min-w-[220px] hover:bg-kiban-surface transition-colors"
			>
				<div class="w-5 h-5 rounded-sm bg-kiban-surface flex-shrink-0"></div>
				<span class="flex-1 text-kiban-ink text-left truncate">{ spaceChipLabel(cfg) }</span>
				@icons.ChevronDown()
			</button>
			<div
				id="topbar-space-switcher-panel"
				role="menu"
				aria-labelledby="topbar-space-switcher-trigger"
				class="hidden absolute left-0 top-full mt-1 z-50 min-w-[260px] max-h-80 overflow-auto bg-white border border-kiban-border rounded-md shadow-lg py-1"
			>
				for _, s := range cfg.Spaces {
					@spaceSwitcherItem(cfg, s)
				}
			</div>
		</div>
	} else {
		<div class="flex items-center gap-2 px-4 py-2 border border-kiban-border rounded-md text-sm min-w-[220px] cursor-default select-none">
			<div class="w-5 h-5 rounded-sm bg-kiban-surface flex-shrink-0"></div>
			<span class="flex-1 text-kiban-ink truncate">{ spaceChipLabel(cfg) }</span>
		</div>
	}
}

// spaceSwitcherItem is one row inside the dropdown panel. We use a
// per-item <form> (instead of links) so the consuming project can
// validate access server-side before setting the kiban_space_id cookie —
// a stale link in a tab open across permission revocations would
// otherwise let the user "switch" into a space they no longer have.
//
// Active item gets a soft tint (kiban-primary-soft) and a non-submittable
// form (still allowed to click, but it's a no-op on the server — the
// redirect from the controller takes the user back to /spaces/:id which
// is exactly where they already are).
templ spaceSwitcherItem(cfg Config, s SpaceOption) {
	<form
		method="POST"
		action={ templ.URL(cfg.SwitchSpaceAction) }
		class="block"
	>
		<input type="hidden" name="spaceId" value={ s.Id }/>
		<button
			type="submit"
			role="menuitem"
			onclick="window.kibanCloseMenu('topbar-space-switcher')"
			class={
				"w-full text-left px-3 py-2 text-sm hover:bg-kiban-surface flex items-center gap-2",
				templ.KV("bg-kiban-primary-soft text-kiban-primary font-medium", s.Id == cfg.SpaceID),
				templ.KV("text-kiban-ink", s.Id != cfg.SpaceID),
			}
		>
			<span class="flex-1 truncate">{ s.Name }</span>
			if s.Id == cfg.SpaceID {
				<span class="text-xs">Actual</span>
			}
		</button>
	</form>
}

// isSpaceSwitcherInteractive decides whether the chip is a clickable
// dropdown or a readonly label. Lifted into its own helper so the
// branching is testable and the templ stays readable.
func isSpaceSwitcherInteractive(cfg Config) bool {
	return len(cfg.Spaces) >= 2 && cfg.SwitchSpaceAction != ""
}

// spaceChipLabel returns the text rendered inside the chip — prefers the
// human-readable name, falls back to "—" when no space is active.
func spaceChipLabel(cfg Config) string {
	if cfg.CurrentSpaceName != "" {
		return cfg.CurrentSpaceName
	}
	if cfg.SpaceID != "" {
		// Fallback for projects that haven't populated CurrentSpaceName yet —
		// keeps the chip showing something contextual instead of "—".
		return cfg.SpaceID
	}
	return "—"
}

// userInitials returns the first character of the user's name (preferred) or
// email (fallback) to render inside the topbar's avatar circle.
func userInitials(u User) string {
	if u.Name != "" {
		return string([]rune(u.Name)[0])
	}
	if u.Email != "" {
		return string([]rune(u.Email)[0])
	}
	return "·"
}
