package menu

import "github.com/kiban-cloud/go-kiban-design-system/view/icons"

// Menu renders the kebab trigger + popover for a row's actions. See
// the package godoc for the visual contract and click-outside-to-close
// behaviour.
templ Menu(c Config) {
	<details class="relative inline-block" data-ds-menu>
		<summary
			id={ c.ID }
			class="list-none cursor-pointer p-1.5 rounded text-kiban-ink3 hover:bg-kiban-surface hover:text-kiban-ink select-none inline-flex items-center justify-center"
			aria-label={ c.AriaLabel }
		>
			@icons.More()
		</summary>
		<div class="absolute right-0 mt-1 w-48 bg-white border border-kiban-border rounded-md shadow-md py-1 z-30">
			for _, item := range c.Items {
				<button
					type="button"
					class={ menuItemClasses(item.Variant) }
					{ itemAttrs(item)... }
				>
					{ item.Label }
				</button>
			}
		</div>
	</details>
	@menuOutsideClickScript()
}

// menuOutsideClickScript registers (idempotently) a document-level
// click listener that closes any open `<details data-ds-menu>` whose
// subtree did not receive the click. Multiple [Menu] invocations on
// the same page emit this template, but the listener registers only
// once via a flag on `window`.
templ menuOutsideClickScript() {
	<script>
		if (!window.__dsMenuInit) {
			window.__dsMenuInit = true;
			document.addEventListener('click', function (e) {
				document.querySelectorAll('details[data-ds-menu][open]').forEach(function (d) {
					if (!d.contains(e.target)) {
						d.removeAttribute('open');
					}
				});
			});
		}
	</script>
}
