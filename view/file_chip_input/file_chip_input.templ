package file_chip_input

import (
	ds_input "github.com/kiban-cloud/go-kiban-design-system/view/input"
)

// Field renders the file picker + the (initially empty) chip list.
// JS — included once per page in [layout.Base] under the
// `[data-kiban-file-chip-input]` selector — populates and removes
// chips client-side. The `<ul data-chip-list>` is the contract: the
// JS finds it inside the wrapper and injects/removes `<li>` elements
// each containing one [chip.Chip].
//
// The file `<input>` is a standard [input.File] so it inherits the
// design-system styling and label / hint behavior. The wrapper carries
// `data-kiban-file-chip-input` so the script (which runs on every htmx
// swap and DOMContentLoaded) finds and binds it. Multiple instances on
// the same page work — each is identified by [Options.ID] and the
// script scopes everything to the wrapper element.
templ Field(opts Options) {
	<div
		id={ opts.effectiveID() }
		{ opts.dataAttrs()... }
	>
		@ds_input.File(opts.Name, opts.Label, opts.Accept, effectiveHint(opts), opts.Required, opts.Multiple)
		<ul data-chip-list class="flex flex-wrap gap-2 mt-2"></ul>
	</div>
}
