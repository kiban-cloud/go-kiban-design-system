package badge

// Variant is the explicit, generic badge: the caller decides the colour
// scheme and size, the component renders the pill. Use this when a
// project's status code isn't covered by `VariantForCode` (i.e. it isn't
// reused across kiban) or when the badge doesn't represent a status at
// all (e.g. tagging a row as "Externo" / "rekon" / etc.).
//
// `variant` accepts: "success" | "warning" | "danger" | "info" | "neutral"
// (empty = "neutral"). `size` accepts: "sm" | "md" (empty = "sm").
templ Variant(label, variant, size string) {
	<span
		class={
			"inline-block rounded-md font-medium whitespace-nowrap",
			templ.KV("px-2 py-1 text-xs", size == "" || size == "sm"),
			templ.KV("px-3 py-1 text-sm", size == "md"),
			templ.KV("bg-emerald-50 text-emerald-700", variant == "success"),
			templ.KV("bg-amber-50 text-amber-700", variant == "warning"),
			templ.KV("bg-red-50 text-red-700", variant == "danger"),
			templ.KV("bg-kiban-primary-soft text-kiban-primary", variant == "info"),
			templ.KV("bg-kiban-surface text-kiban-ink2", variant == "neutral" || variant == ""),
		}
	>
		{ label }
	</span>
}

// Status is the convenience wrapper for the kiban-shared backend codes.
// It looks up `code` in `VariantForCode` to pick the variant, then
// delegates to `Variant`. The label is whatever Spanish (or other-locale)
// string the backend wants to surface — Status doesn't try to translate
// codes to labels, it only colours the pill.
//
// Use this when the code IS one of the shared kiban codes; otherwise
// call `Variant` directly so the lookup doesn't quietly fall through to
// neutral on a code it doesn't recognise.
templ Status(code, label, size string) {
	@Variant(label, VariantForCode(code), size)
}
