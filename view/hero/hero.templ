package hero

import (
	"strconv"

	"github.com/kiban-cloud/go-kiban-design-system/view/flamboyant"
	"github.com/kiban-cloud/go-kiban-design-system/view/layout"
)

// Cycle es el hero azul de la página de inicio de un módulo flamboyant: el
// chip del espacio, el saludo y su línea, el botón de lo que hay que revisar
// y el ciclo del módulo, un paso por pantalla con su cifra del día. Lo
// estrenó el resumen de rekon flamboyant en kiban-proto (Cobra · Recibe ·
// Retira · Dispersa); Base y Monitoreo usan el mismo.
templ Cycle(o CycleOptions) {
	<section class="relative isolate overflow-hidden rounded-[20px] px-7 pb-6 pt-7 text-white max-sm:px-5" style={ heroStyle } data-kiban-hero>
		<div class="pointer-events-none absolute -right-[30px] -top-[60px] -z-10 h-[300px] w-[300px] rotate-[-8deg] opacity-90" aria-hidden="true">
			<span class="absolute" style={ meshTopStyle }></span>
			<span class="absolute" style={ meshBottomStyle }></span>
			<span class="absolute" style={ meshRightStyle }></span>
		</div>
		<div class="pointer-events-none absolute -bottom-[60%] -right-[10%] left-[30%] -z-10 h-[120%]" style={ glowStyle } aria-hidden="true"></div>
		<div class="flex flex-wrap items-start justify-between gap-4">
			<div>
				if o.Space != "" {
					<div class={ spaceClass(o.SpaceTile != nil || !flamboyant.On(ctx)) }>
						if o.SpaceTile != nil {
							@o.SpaceTile
						}
						{ o.Space }
					</div>
				}
				if o.TitleTrend != "" {
					<h1 class="mb-1 mt-2.5 text-[34px] font-semibold leading-10 tracking-[-.02em] max-[900px]:text-[28px] max-[900px]:leading-[34px]">
						{ o.Title }
						<span class={ trendClass(o.TitleTrendDown) }>{ o.TitleTrend }</span>
					</h1>
				} else {
					<h1 class="mb-1 mt-2.5 text-[34px] font-semibold leading-10 tracking-[-.02em] max-[900px]:text-[28px] max-[900px]:leading-[34px]">{ o.Title }</h1>
				}
				if o.Text != "" {
					<p class="m-0 max-w-[52ch] text-[15px] text-white/80">{ o.Text }</p>
				}
			</div>
			if o.Action != nil {
				<div class="flex flex-wrap items-center gap-2.5">
					<a href={ templ.SafeURL(o.Action.Href) } class="inline-flex h-11 items-center gap-2 rounded-full bg-white px-4 text-sm font-semibold text-[#0036C4] shadow-[0_8px_24px_-10px_rgba(0,0,0,.45)] hover:bg-[#EEF3FF]" { o.Action.Attrs... }>
						@layout.FlamboyantIcon("play")
						{ o.Action.Label }
					</a>
					@pending(o)
				</div>
			} else {
				@pending(o)
			}
		</div>
		if len(o.Steps) > 0 {
			<div class="relative mt-[18px] overflow-x-auto pb-1 pt-2.5 [scrollbar-width:none]">
				<div class="relative grid grid-cols-[var(--cy-cols)] gap-1 min-[900px]:grid-cols-[var(--cy-cols-lg)]" style={ cycleVars(len(o.Steps)) } role="list" aria-label={ o.StepsLabel }>
					<div class="absolute left-[75px] top-[27px] h-0.5 w-[var(--cy-line)] overflow-hidden rounded-sm bg-white/30 min-[900px]:left-[var(--cy-inset)] min-[900px]:right-[var(--cy-inset)] min-[900px]:w-auto" aria-hidden="true" data-kiban-hero-line>
						if o.Animated {
							<i class="kiban-cy-flow"></i>
							<i class="kiban-cy-flow"></i>
							<i class="kiban-cy-flow"></i>
						}
					</div>
					for i, s := range o.Steps {
						<a href={ templ.SafeURL(s.Href) } role="listitem" class="relative flex flex-col items-center gap-0.5 rounded-[14px] px-1 pb-1.5 text-center text-white transition-transform hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
							<span class="kiban-cy-in relative mb-2 grid h-14 w-14 place-items-center rounded-[18px] bg-white text-kiban-primary shadow-[0_10px_24px_-12px_rgba(0,0,0,.6)] [&>svg]:h-6 [&>svg]:w-6" style={ stepStyle(i) }>
								if s.Icon != nil {
									@s.Icon
								}
								if s.Badge > 0 {
									<i class="absolute -right-1.5 -top-1.5 h-5 min-w-5 rounded-full bg-[#00DDB2] px-[5px] text-[11px] font-bold not-italic leading-5 text-[#04332A] shadow-[0_0_0_2px_#0047FF]">{ strconv.Itoa(s.Badge) }</i>
								}
							</span>
							<span class="text-[11px] font-semibold uppercase tracking-[.08em] text-white/70">{ s.Verb }</span>
							<b class="text-[15px] font-semibold">{ s.Name }</b>
							if s.Sub != "" {
								<small class="text-xs leading-[18px] tabular-nums text-white/80 min-[900px]:whitespace-nowrap">{ s.Sub }</small>
							}
						</a>
					}
				</div>
			</div>
		}
	</section>
}

const pendingClass = "inline-flex h-11 items-center gap-2.5 rounded-full bg-white pl-3 pr-3.5 text-sm text-[#0036C4] shadow-[0_8px_24px_-10px_rgba(0,0,0,.45)] hover:bg-[#EEF3FF]"

// pending es el botón «N por revisar» (nada sin pendientes). Sin Action va
// suelto, como siempre; con Action, junto a ella.
templ pending(o CycleOptions) {
	if o.PendingCount > 0 {
		if o.PendingAttrs != nil {
			<button type="button" class={ pendingClass } { o.PendingAttrs... }>
				@pendingBody(o)
			</button>
		} else {
			<a href={ templ.SafeURL(o.PendingHref) } class={ pendingClass }>
				@pendingBody(o)
			</a>
		}
	}
}

// pendingBody es el contenido del botón «N por revisar».
templ pendingBody(o CycleOptions) {
	@layout.FlamboyantIcon(pendingIcon(o))
	<span><b class="font-bold">{ strconv.Itoa(o.PendingCount) }</b> { o.PendingLabel }</span>
	@layout.FlamboyantIcon("chevron-right")
}
