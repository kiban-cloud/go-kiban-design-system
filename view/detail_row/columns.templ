package detail_row

// Columns son los datos de una ficha en columnas a todo el ancho, cada una
// con su antetítulo y separadas por una línea vertical (flamboyant: la ficha
// del cliente). En pantallas angostas pasan a dos y a una columna.
templ Columns(groups []Group) {
	<div class="grid grid-cols-1 gap-y-5 sm:grid-cols-2 xl:grid-cols-5">
		for _, g := range groups {
			<section class="min-w-0 xl:border-l xl:border-[#EEF0F4] xl:px-6 xl:first:border-l-0 xl:first:pl-0">
				<h3 class="mb-3 text-[11px] font-semibold uppercase tracking-[.06em] text-[#9096A3]">{ g.Title }</h3>
				if len(g.Fields) == 0 {
					<p class="m-0 text-sm text-kiban-ink3">{ g.Empty }</p>
				} else {
					<dl class="m-0 flex flex-col gap-3.5">
						for _, f := range g.Fields {
							<div>
								<dt class="text-xs leading-4 text-[#606875]">{ f.Label }</dt>
								<dd class="m-0 mt-[3px] text-sm leading-[21px] text-kiban-ink [overflow-wrap:anywhere]">
									if f.Value != nil {
										@f.Value
									} else if f.Text != "" {
										{ f.Text }
									} else {
										<span class="text-kiban-ink4">—</span>
									}
								</dd>
							</div>
						}
					</dl>
				}
			</section>
		}
	</div>
}
