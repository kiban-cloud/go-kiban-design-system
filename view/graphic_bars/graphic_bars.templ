package graphic_bars

// GraphicBars renders the chart inside its host (typically a card or
// card section). The header (Title) is optional — when set the
// renderer emits a small heading above the rows. Each Bar produces one
// row: label on the left, formatted Total on the right, and a track
// below with a fill bar whose width tracks Percent. When HidePercent is
// off, a trailing percent column sits between Total and the bar.
//
// No Bars renders the "(sin datos)" placeholder so the host still
// shows the chrome without an empty void.
templ GraphicBars(opts Options) {
	<div class="space-y-3">
		if opts.Title != "" {
			<div class="text-sm font-medium text-kiban-ink">{ opts.Title }</div>
		}
		if len(opts.Bars) == 0 {
			<div class="text-xs italic text-kiban-ink3">(sin datos)</div>
		} else {
			<div class="space-y-3">
				for _, bar := range opts.Bars {
					@graphicBarRow(bar, opts.Variant, opts.HidePercent)
				}
			</div>
		}
	</div>
}

// graphicBarRow is the per-row layout. The two text columns sit on a
// flex row so the label can truncate independently of the value, and
// the track sits below them spanning the full row width.
templ graphicBarRow(bar Bar, variant string, hidePercent bool) {
	<div class="space-y-1">
		<div class="flex items-baseline justify-between gap-2 text-xs">
			<span class="text-kiban-ink2 truncate">{ bar.Label }</span>
			<span class="text-kiban-ink shrink-0 tabular-nums">
				{ bar.Total }
				if !hidePercent {
					<span class="text-kiban-ink3 ml-1">({ formatPercent(clampPercent(bar.Percent)) }%)</span>
				}
			</span>
		</div>
		<div class={ barTrackClass() } style={ barTrackStyle(variant) } role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={ formatPercent(clampPercent(bar.Percent)) }>
			<div class={ barFillClass() } style={ barFillStyle(variant, bar.Percent) }></div>
		</div>
	</div>
}
