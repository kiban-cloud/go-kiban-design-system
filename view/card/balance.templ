package card

import "github.com/kiban-cloud/go-kiban-design-system/view/badge"

// BalanceGrid es la fila de cuadros de saldo (Balance), de al menos 280 px
// cada uno. narrow: un solo cuadro de hasta 380 px (rekon Dispersión, que
// sólo muestra una cuenta).
templ BalanceGrid(narrow bool) {
	<div class={ "grid items-start gap-3", templ.KV("grid-cols-[repeat(auto-fit,minmax(280px,1fr))]", !narrow), templ.KV("grid-cols-[minmax(0,380px)]", narrow) } data-kiban-balance-grid>
		{ children... }
	</div>
}

// Balance es el cuadro del saldo de una cuenta en flamboyant: placa y título,
// el saldo grande con su moneda y abajo qué se puede hacer con él (pie con
// texto y acción, o un renglón por saldo agrupado con BalanceLine). Lo
// estrenaron rekon Retiros (un cuadro por medio de pago, STP con sus centros
// de costos) y Dispersión en kiban-proto.
templ Balance(o BalanceOptions) {
	<div
		class={ "flex min-w-0 flex-col gap-3 rounded-[10px] border px-[18px] py-4",
			templ.KV("border-[#DCE5FF] bg-[#F4F7FF]", o.Live),
			templ.KV("border-[#E2E5EC] bg-white", !o.Live) }
		data-kiban-balance={ o.Key }
	>
		<div class="flex min-w-0 items-center gap-2.5">
			if o.Tile != nil {
				@o.Tile
			}
			<div class="min-w-0 flex-1">
				<div class="text-[13px] font-medium leading-5 text-kiban-ink">{ o.Title }</div>
				if o.Sub != "" {
					<div class="truncate text-xs leading-4 text-[#606875]">{ o.Sub }</div>
				}
			</div>
			if o.Live {
				@badge.Variant(o.LiveLabel, "success", "sm")
			}
		</div>
		<div class={ "text-[22px] font-semibold leading-7 tabular-nums", templ.KV("text-[#9096A3]", o.Zero), templ.KV("text-kiban-ink", !o.Zero) }>
			{ o.Amount }
			<small class="ml-1 text-xs font-medium leading-7 text-[#9096A3]">{ o.Currency }</small>
		</div>
		if len(o.Lines) > 0 {
			<div class="flex flex-col gap-1.5 border-t border-[#EEF0F4] pt-3">
				for _, l := range o.Lines {
					@BalanceLine(o.line(l))
				}
			</div>
		} else {
			<div class="flex items-center justify-between gap-2 border-t border-[#EEF0F4] pt-3">
				<span class="text-xs text-[#606875]">{ o.Foot }</span>
				if o.Action != nil {
					@o.Action
				}
			</div>
		}
	</div>
}

// BalanceLine es un saldo agrupado dentro de un cuadro Balance (un centro de
// costos de STP en rekon Retiros): nombre, saldo con moneda y su acción.
templ BalanceLine(o BalanceLineOptions) {
	<div class="flex items-center justify-between gap-2.5" data-kiban-balance-line>
		<span class="min-w-0">
			<b class="block truncate text-[13px] font-medium text-kiban-ink">{ o.Name }</b>
			<small class="block text-xs leading-[18px] tabular-nums text-[#606875]">{ o.Amount } { o.Currency }</small>
		</span>
		if o.Action != nil {
			@o.Action
		}
	</div>
}

// BalanceLink es el enlace del pie de un cuadro de saldo («Ir a Dispersión»,
// «Nueva dispersión»). attrs permite abrir un panel con htmx en vez de
// navegar.
templ BalanceLink(label, href string, attrs templ.Attributes) {
	<a href={ templ.SafeURL(href) } class="text-[13px] font-medium leading-[17px] text-kiban-primary hover:underline" { attrs... }>{ label }</a>
}
