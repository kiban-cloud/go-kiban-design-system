package card

import (
	"github.com/kiban-cloud/go-kiban-design-system/view/chart"
	"github.com/kiban-cloud/go-kiban-design-system/view/flamboyant"
)

// BentoGrid es la cuadrícula de tarjetas Bento: una columna en móvil, dos
// desde md y seis desde xl (cada tarjeta dice cuántas ocupa con Cols).
templ BentoGrid() {
	<div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-6" data-kiban-bento-grid>
		{ children... }
	</div>
}

// Bento es la tarjeta de una pieza en la página de inicio de un módulo
// flamboyant: franja de color, ícono, título y qué es; dos cifras y la
// tendencia de los últimos días; lo que hay que revisar; el botón para
// entrar y sus enlaces. La grande (Big) pone las cifras a la izquierda de la
// tendencia. La estrenó el resumen de rekon flamboyant en kiban-proto (Pagos,
// Órdenes de pago, Retiros, Dispersión); Base y Monitoreo usan la misma.
templ Bento(o BentoOptions) {
	<article
		class={ "group relative flex min-w-0 flex-col gap-4 overflow-hidden rounded-[18px] border border-[#E2E5EC] bg-white p-5 transition hover:-translate-y-0.5 hover:border-[color-mix(in_srgb,var(--c)_40%,#E2E5EC)] hover:shadow-[0_18px_40px_-24px_color-mix(in_srgb,var(--c)_70%,transparent)]", bentoCols(o.Cols), templ.KV("xl:row-span-2", o.Rows == 2), templ.KV("md:col-span-2", o.Big) }
		style={ bentoStyle(o) }
		data-kiban-bento
	>
		<div class="absolute inset-x-0 top-0 h-1 bg-[var(--c)] opacity-90" aria-hidden="true"></div>
		<header class="flex items-start gap-3.5">
			<span class="grid h-11 w-11 flex-none place-items-center rounded-[14px] bg-[var(--s)] text-[var(--c)] [&>svg]:h-[22px] [&>svg]:w-[22px]">
				if o.Icon != nil {
					@o.Icon
				}
			</span>
			<div class="min-w-0 flex-1">
				<h2 class={ "m-0 font-semibold text-[#1A2035]", templ.KV("text-[22px] leading-7", o.Big), templ.KV("text-lg leading-6", !o.Big) }>{ o.Title }</h2>
				<p class="mt-1 text-[13px] leading-[19px] text-[#606875]">{ o.Text }</p>
			</div>
			if o.Pending != "" {
				<span class="flex-none whitespace-nowrap rounded-full bg-[#CCF8EF] px-2.5 py-[3px] text-xs font-semibold text-[#04332A]">{ o.Pending }</span>
			}
		</header>
		<div class={ templ.KV("grid items-end gap-5 md:grid-cols-[minmax(0,200px)_minmax(0,1fr)]", o.Big), templ.KV("flex flex-col gap-3", !o.Big) }>
			if len(o.Kpis) > 0 || !flamboyant.On(ctx) {
				<div class={ templ.KV("flex flex-wrap gap-x-7 gap-y-4 md:flex-col md:flex-nowrap", o.Big), templ.KV("grid grid-cols-2 gap-3", !o.Big) }>
					for _, k := range o.Kpis {
						@bentoKpi(k, o.Big)
					}
				</div>
			}
			if o.Body != nil {
				<div class="min-w-0">
					@o.Body
				</div>
			} else {
				<div class="relative">
					<div class="absolute left-0 top-0 text-[11px] text-[#9096A3]">{ o.TrendUnit }</div>
					{{ w, h, class := bentoSpark(o) }}
					@chart.Spark(chart.SparkOptions{Values: o.Trend, Color: o.Color, Width: w, Height: h, Class: class})
					<div class="mt-1 flex justify-between text-[11px] text-[#9096A3]">
						for _, a := range o.Axis {
							<span>{ a }</span>
						}
					</div>
				</div>
			}
		</div>
		if len(o.Live) > 0 {
			<div class="flex flex-col gap-1 rounded-xl bg-[var(--s)] p-1.5">
				<div class="flex items-center gap-2 px-2 pb-0.5 pt-1.5 text-[11px] font-semibold uppercase tracking-[.06em] text-[var(--c)]">
					<span class="relative flex h-2 w-2">
						<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[var(--c)] opacity-60 motion-reduce:animate-none"></span>
						<span class="relative inline-flex h-2 w-2 rounded-full bg-[var(--c)]"></span>
					</span>
					{ o.LiveTitle }
				</div>
				for _, r := range o.Live {
					<a href={ templ.SafeURL(r.Href) } { r.Attrs... } class="grid w-full grid-cols-[minmax(0,1fr)_auto_16px] items-center gap-2.5 rounded-[10px] bg-white px-2.5 py-2 text-left text-[#9096A3] hover:shadow-[inset_0_0_0_1px_var(--c)] [&>svg]:h-4 [&>svg]:w-4">
						<span class="min-w-0">
							<b class="block truncate text-[13px] font-medium text-[#1A2035]">{ r.Title }</b>
							<small class="block truncate text-xs leading-[18px] text-[#606875]">{ r.Sub }</small>
						</span>
						<time class="whitespace-nowrap text-xs leading-[18px]">{ r.When }</time>
						@templ.Raw(chevronRight)
					</a>
				}
			</div>
		}
		<footer class="mt-auto flex flex-wrap items-center gap-3.5">
			if o.Open.Label != "" {
				<a href={ templ.SafeURL(o.Open.Href) } { o.Open.Attrs... } class="inline-flex h-9 items-center gap-1.5 rounded-[10px] bg-[var(--c)] pl-3.5 pr-3 text-[13px] font-medium text-white hover:brightness-110 [&>svg]:h-4 [&>svg]:w-4">
					{ o.Open.Label }
					@templ.Raw(chevronRight)
				</a>
			}
			for _, l := range o.Links {
				<a href={ templ.SafeURL(l.Href) } { l.Attrs... } class="text-[13px] font-medium text-kiban-primary hover:underline">{ l.Label }</a>
			}
		</footer>
	</article>
}

// bentoKpi es una cifra de Bento. Los montos son largos: 22 px en las
// tarjetas chicas, 32 en la grande (26 en móvil).
templ bentoKpi(k BentoKpi, big bool) {
	<div>
		<b class={ "block font-semibold tracking-[-.01em] text-[#1A2035] tabular-nums", templ.KV("text-[26px] leading-8 md:text-[32px] md:leading-10", big), templ.KV("text-[22px] leading-[30px]", !big) }>{ k.Value }</b>
		<small class="block text-xs leading-[18px] text-[#606875]">{ k.Label }</small>
	</div>
}
