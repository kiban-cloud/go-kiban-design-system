package card

import "github.com/kiban-cloud/go-kiban-design-system/view/flamboyant"

// Step es una sección de formulario con título. En kiban cloud flamboyant es
// la tarjeta numerada de los paneles: el número lo pone el navegador según
// los pasos visibles y se pinta azul cuando el paso está completo (salvo
// NoProgress)
// (base.templ, [data-kiban-step]). Con el diseño de siempre es un Card con el
// mismo encabezado que usaban las secciones a mano: sólo título, título con
// ayuda debajo o título con algo a la derecha.
templ Step(o StepOptions) {
	if flamboyant.On(ctx) {
		<div class="flex flex-col gap-3.5 rounded-[10px] border border-[#CDD3DF] bg-white p-5" data-kiban-step={ o.Key } data-kiban-step-required={ o.required() }>
			<div class="flex items-center gap-2">
				<h3 class="m-0 flex items-center gap-2 text-[15px] font-medium leading-[22px] text-kiban-ink">
					if !o.NoNumber {
						<span
							class={
								"grid h-[22px] w-[22px] shrink-0 place-items-center rounded-full border border-[#CDD3DF] bg-[#F4F7FF] text-[11px] font-semibold leading-none text-[#474F66] transition-colors",
								templ.KV("data-[ok]:border-kiban-primary data-[ok]:bg-kiban-primary data-[ok]:text-white", !o.NoProgress),
							}
							data-kiban-step-n
						>·</span>
					}
					{ o.Title }
				</h3>
				if o.Right != nil {
					<div class="ml-auto">
						@o.Right
					</div>
				}
			</div>
			if o.hasHint() {
				<p class="m-0 text-[13px] leading-[18px] text-[#606875]">
					@stepHint(o)
				</p>
			}
			<div class="flex flex-col gap-4">
				{ children... }
			</div>
		</div>
	} else {
		@Card("") {
			if o.Right != nil {
				<div class="flex items-center justify-between">
					<div class="font-heading font-medium text-base">{ o.Title }</div>
					@o.Right
				</div>
			} else if o.hasHint() {
				<div>
					<div class="font-heading font-medium text-base">{ o.Title }</div>
					<div class="text-xs text-kiban-ink3 mt-1">
						@stepHint(o)
					</div>
				</div>
			} else {
				<div class="font-heading font-medium text-base">{ o.Title }</div>
			}
			{ children... }
		}
	}
}

templ stepHint(o StepOptions) {
	if o.Hint != nil {
		@o.Hint
	} else {
		{ o.HintText }
	}
}
