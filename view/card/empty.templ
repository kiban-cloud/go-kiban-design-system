package card

// Empty es un estado vacío dentro de una sección (flamboyant): borde
// punteado, un ícono arriba (Icon, ya en su cuadro), título y texto.
// children son acciones opcionales.
templ Empty(o EmptyOptions) {
	<div class="flex flex-col items-center gap-2.5 rounded-xl border border-dashed border-[#E2E5EC] px-4 py-14 text-center">
		if o.Icon != nil {
			@o.Icon
		}
		<div class="text-base font-medium text-kiban-ink">{ o.Title }</div>
		if o.Text != "" {
			<div class="max-w-md text-sm text-kiban-ink3">{ o.Text }</div>
		}
		<div class="flex justify-center gap-2 empty:hidden">{ children... }</div>
	</div>
}
