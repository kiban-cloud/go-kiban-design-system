package ipblocked

import (
	"github.com/kiban-cloud/go-kiban-design-system/view/button"
	"github.com/kiban-cloud/go-kiban-design-system/view/layout"
	"github.com/kiban-cloud/go-kiban-design-system/view/logo"
)

// Page is the whole document for a request from an IP the Console list
// doesn't allow. data-ip-blocked carries the tool so tests can tell the
// screen apart without matching copy.
templ Page(tool, ip string) {
	@layout.Base(layout.Config{Title: t(ctx, "ip_blocked.page_title"), ProjectName: "kiban cloud"}) {
		<main class="min-h-screen flex items-center justify-center bg-kiban-surface px-4 py-12" data-ip-blocked={ tool }>
			<div class="w-full max-w-lg rounded-md border border-kiban-border bg-white p-8 md:p-10 text-center">
				<div class="flex justify-center mb-8">
					@logo.KibanCloud("h-7 w-auto")
				</div>
				<div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-amber-700 text-2xl" aria-hidden="true">🔒</div>
				<h1 class="text-xl font-heading font-bold text-kiban-ink">{ t(ctx, "ip_blocked.title") }</h1>
				<p class="mt-3 text-sm text-kiban-ink2">
					{ t(ctx, "ip_blocked.body_before_ip") }
					<code class="font-mono text-kiban-ink bg-kiban-surface rounded px-1.5 py-0.5">{ ip }</code>
					{ tf(ctx, "ip_blocked.body_after_ip", map[string]any{"Tool": ToolLabel(ctx, tool)}) }
				</p>
				<p class="mt-2 text-sm text-kiban-ink3">{ t(ctx, "ip_blocked.hint") }</p>
				<div class="mt-8 flex flex-col-reverse sm:flex-row gap-3 justify-center">
					@button.Button(button.Options{
						Label:   t(ctx, "ip_blocked.review"),
						Variant: "secondary",
						Href:    IpAccessHref,
					})
					@button.Button(button.Options{
						Label:   t(ctx, "ip_blocked.spaces"),
						Variant: "primary",
						Href:    SpacesHref,
					})
				</div>
			</div>
		</main>
	}
}
