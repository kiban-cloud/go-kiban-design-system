package canvas

import (
	"github.com/kiban-cloud/go-kiban-design-system/view/flamboyant"
	"github.com/kiban-cloud/go-kiban-design-system/view/icons"
)

// Canvas wraps a vertical stack of Node/EdgeButton children plus a sibling
// SVG overlay where the runtime JS paints the edges. The flex column keeps
// the cards visually centered and forbids overlaps (the children share the
// same column; the JS only paints lines between their measured positions).
//
// data-edges is consumed by the kibanCanvasRender JS in view/layout/base.templ.
// When Edges is empty, no SVG paths are drawn — useful for empty/single-node
// canvases.
templ Canvas(cfg CanvasOptions) {
	<div
		id={ canvasID(cfg.ID) }
		data-kiban-canvas
		data-edges={ encodeEdges(cfg.Edges) }
		data-kiban-canvas-compact?={ flamboyant.On(ctx) }
		class="relative w-full"
	>
		if flamboyant.On(ctx) {
			@compactStyle()
		}
		<svg
			data-kiban-canvas-edges
			class="absolute inset-0 pointer-events-none"
			width="100%"
			height="100%"
			aria-hidden="true"
		></svg>
		<div data-kiban-canvas-stage class="relative flex flex-col items-center gap-10 py-8">
			{ children... }
			if cfg.EmptyMessage != "" {
				<div data-kiban-canvas-empty class="flex flex-col items-center gap-4 text-center text-kiban-ink3">
					<div class="text-sm">{ cfg.EmptyMessage }</div>
					if cfg.EmptyAction != nil {
						@cfg.EmptyAction
					}
				</div>
			}
		</div>
	</div>
}

// Node is a single workfloo card. The DOM id is required because the edge
// JS resolves edges by querying [id=…] inside the parent canvas. The card's
// border + background tint shifts with Status; nodes with non-ok status get
// a small pill on the bottom-right indicating the state.
//
// Href turns the card into an <a> for click-to-edit; without it the card is
// a div and the caller wires interactivity via Attrs (HTMX or onclick).
//
// ActionMenu is rendered absolutely in the top-right of the card so the
// title row keeps its own flex layout.
templ Node(opts NodeOptions) {
	if flamboyant.On(ctx) {
		@flNode(opts)
	} else if opts.Href != "" {
		<a
			id={ opts.ID }
			href={ templ.SafeURL(opts.Href) }
			data-kiban-canvas-node
			data-status={ opts.Status }
			class={ nodeShellClass(opts.Status) + " block px-4 py-3 no-underline" }
			{ opts.Attrs... }
		>
			@nodeInner(opts)
		</a>
	} else {
		<div
			id={ opts.ID }
			data-kiban-canvas-node
			data-status={ opts.Status }
			class={ nodeShellClass(opts.Status) + " px-4 py-3" }
			{ opts.Attrs... }
		>
			@nodeInner(opts)
		</div>
	}
}

templ nodeInner(opts NodeOptions) {
	<div class="flex items-start gap-3">
		if opts.Icon != nil {
			<div class="shrink-0 mt-0.5 w-8 h-8 rounded-md bg-kiban-primary-soft text-kiban-primary flex items-center justify-center">
				@opts.Icon
			</div>
		}
		<div class="flex-1 min-w-0">
			<div class="text-sm font-medium text-kiban-ink truncate">{ opts.Title }</div>
			if opts.Subtitle != "" {
				<div class="text-xs text-kiban-ink3 truncate mt-0.5">{ opts.Subtitle }</div>
			}
		</div>
		if opts.ActionMenu != nil {
			<div class="shrink-0" onclick="event.stopPropagation()">
				@opts.ActionMenu
			</div>
		}
	</div>
	if opts.Status == StatusError || opts.Status == StatusNotConfigured {
		<div class="mt-2 flex justify-end">
			<span class={ statusPillClass(opts.Status) }>{ statusPillLabel(opts.Status) }</span>
		</div>
	}
}

// EdgeButton is the "+" affordance rendered between nodes. The caller drops
// it into the Canvas children between two consecutive @Node calls; the
// runtime JS positions the edges to start/end at the surrounding nodes, so
// the button sits visually on top of the connector line at its midpoint.
//
// Attrs carries the HTMX wiring (hx-get, hx-target, …) or an onclick that
// opens the connector picker overlay.
templ EdgeButton(opts EdgeButtonOptions) {
	<div data-kiban-canvas-edge-button class="relative z-10">
		<button
			type="button"
			aria-label={ opts.AriaLabel }
			class="w-8 h-8 rounded-full border border-kiban-border bg-white text-kiban-ink3 hover:text-kiban-primary hover:border-kiban-primary shadow-sm flex items-center justify-center transition-colors"
			{ opts.Attrs... }
		>
			@icons.Plus()
		</button>
	</div>
}

// compactStyle es el espaciado de flamboyant: los pasos más juntos (45 px
// entre tarjetas, con el «+» de 24 px en medio) y las ramas un poco más
// separadas del paso que las abre.
templ compactStyle() {
	<style>
		[data-kiban-canvas-compact] [data-kiban-canvas-stage],[data-kiban-canvas-compact] [data-kiban-canvas-row],[data-kiban-canvas-compact] [data-kiban-canvas-row]>div,[data-kiban-canvas-compact] [data-kiban-canvas-chain-row],[data-kiban-canvas-compact] [data-kiban-canvas-chain-row]>div,[data-kiban-canvas-compact] [data-kiban-canvas-branch-column]{gap:0!important}
		[data-kiban-canvas-compact] [data-kiban-canvas-edge-button]{height:45px;display:flex;align-items:center;justify-content:center}
		[data-kiban-canvas-compact] [data-kiban-canvas-edge-button]>button{width:24px;height:24px}
		[data-kiban-canvas-compact] [data-kiban-canvas-edge-button]>button svg{width:13px;height:13px}
		[data-kiban-canvas-compact] div[data-kiban-canvas-branch-row][data-kiban-canvas-branch-row]{margin-top:28px;gap:24px!important}
		[data-kiban-canvas-compact] [data-kiban-canvas-stage]>[data-kiban-canvas-row]+[data-kiban-canvas-row]{margin-top:0}
	</style>
}

// flNode es la tarjeta en flamboyant: cuadro (logo o ícono), título y
// subtítulo en una línea cada uno, el estado abajo como píldora («Falta
// configurar», «Revisa la configuración») y las acciones en una barrita que
// aparece al pasar el mouse (siempre en pantallas táctiles). Con Outcome es
// la píldora de resultado de una rama.
templ flNode(opts NodeOptions) {
	<div
		id={ opts.ID }
		data-kiban-canvas-node
		data-status={ opts.Status }
		class={ flNodeClass(opts) }
		{ opts.Attrs... }
	>
		if opts.Outcome != "" {
			<div class="grid w-full grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2">
				<span class={ "h-2 w-2 rounded-full", flOutcomeDot(opts.Outcome) }></span>
				<span class="truncate text-[13px] font-medium text-kiban-ink">{ opts.Title }</span>
				if opts.Status == StatusError {
					<span class="inline-flex items-center gap-1.5 rounded-full bg-[#FDECEC] px-2 py-0.5 text-[11px] font-medium text-[#B42318]"><i class="h-1.5 w-1.5 rounded-full bg-[#E5484D]"></i>Revisar</span>
				} else if opts.OutcomeLabel != "" {
					<span class="text-[11px] text-[#9096A3]">{ opts.OutcomeLabel }</span>
				}
			</div>
		} else {
			<div class="grid grid-cols-[36px_minmax(0,1fr)] items-center gap-2.5">
				if opts.Tile != nil {
					@opts.Tile
				} else if opts.Icon != nil {
					<span class="grid h-9 w-9 place-items-center rounded-lg bg-[#EAF0FF] text-[#0036C4] [&>svg]:h-[17px] [&>svg]:w-[17px]">
						@opts.Icon
					</span>
				} else {
					<span></span>
				}
				<div class="min-w-0">
					<div class="truncate pr-1 text-sm font-medium text-kiban-ink">{ opts.Title }</div>
					if opts.Subtitle != "" {
						<div class="mt-px truncate text-xs text-[#606875]">{ opts.Subtitle }</div>
					}
				</div>
			</div>
			if opts.Status == StatusNotConfigured {
				<div class="mt-2 flex gap-1.5 border-t border-dashed border-[#E8E8E8] pt-2">
					<span class="inline-flex items-center gap-1.5 rounded-full bg-[#F3EAFF] px-2 py-0.5 text-[11px] font-medium text-[#6A00D6]"><i class="h-1.5 w-1.5 rounded-full bg-[#8000FF]"></i>Falta configurar</span>
				</div>
			} else if opts.Status == StatusError {
				<div class="mt-2 flex gap-1.5 border-t border-dashed border-[#E8E8E8] pt-2">
					<span class="inline-flex items-center gap-1.5 rounded-full bg-[#FDECEC] px-2 py-0.5 text-[11px] font-medium text-[#B42318]"><i class="h-1.5 w-1.5 rounded-full bg-[#E5484D]"></i>Revisa la configuración</span>
				</div>
			}
		}
		if opts.ActionMenu != nil {
			<div
				class="pointer-events-none absolute right-1.5 top-1.5 flex gap-0.5 rounded-lg bg-white p-0.5 opacity-0 shadow-[0_0_0_1px_#E8E8E8,0_4px_10px_-6px_rgba(26,32,53,0.25)] transition-opacity group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100 [@media(hover:none)]:pointer-events-auto [@media(hover:none)]:opacity-100"
				role="toolbar"
				onclick="event.stopPropagation()"
			>
				@opts.ActionMenu
			</div>
		}
	</div>
}
