package filterbar

import "strconv"

// Bar es la barra completa. children van a la derecha (los botones de la
// pantalla: «Carga masiva», «Nuevo cliente»).
templ Bar(cfg Config) {
	<form
		id={ cfg.ID }
		class="flex min-h-9 flex-wrap items-center gap-2"
		hx-get={ cfg.Action }
		hx-target={ cfg.Target }
		hx-swap="innerHTML"
		hx-push-url="true"
		hx-indicator={ cfg.Indicator }
		hx-trigger="submit, change[!event.target.closest('[data-kiban-filter-q],[data-kiban-filter-manual]')], input changed delay:300ms from:find input[type=search]"
	>
		@State(cfg, false)
		<label class="flex h-9 min-w-[220px] flex-[0_1_340px] items-center gap-2 rounded-md border border-[#CDD3DF] bg-white px-2.5 text-[#9096A3] focus-within:border-kiban-primary focus-within:shadow-[0_0_0_3px_rgba(0,71,255,0.12)] max-sm:flex-[1_1_100%]">
			<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
			<input
				type="search"
				name={ cfg.Search.Name }
				value={ cfg.Search.Value }
				placeholder={ cfg.Search.Placeholder }
				aria-label={ cfg.Search.AriaLabel }
				autocomplete="off"
				class="h-full min-w-0 flex-1 border-0 bg-transparent text-sm text-kiban-ink outline-none placeholder:text-[#9096A3]"
			/>
		</label>
		for _, f := range cfg.Filters {
			@filter(cfg, f)
		}
		if cfg.ClearHref != "" {
			<a href={ templ.URL(cfg.ClearHref) } class="px-1 py-1.5 text-[13px] font-medium text-kiban-primary hover:underline" data-kiban-filter-clear hidden?={ !cfg.active() }>{ cfg.ClearLabel }</a>
		}
		<span class="flex-1"></span>
		{ children... }
	</form>
}

templ filter(cfg Config, f Filter) {
	<details class="relative" data-kiban-filter={ f.Name } data-label={ f.Label } data-kiban-filter-numeric?={ f.Numeric != nil }>
		<summary
			class="inline-flex h-9 cursor-pointer list-none items-center gap-1.5 whitespace-nowrap rounded-full border border-[#CDD3DF] bg-white px-3 text-[13px] font-medium text-[#474F66] hover:bg-[#F4F7FF] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-kiban-primary data-[on]:border-kiban-primary data-[on]:bg-[rgba(0,71,255,0.08)] data-[on]:text-[#0036C4] [&::-webkit-details-marker]:hidden"
			data-kiban-filter-pill
			data-on?={ f.on() }
		>
			<span data-kiban-filter-text>
				@pillText(f)
			</span>
			<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
		</summary>
		if f.Numeric != nil {
			@numericMenu(cfg, f, *f.Numeric)
		} else {
			@optionsMenu(cfg, f)
		}
	</details>
}

templ optionsMenu(cfg Config, f Filter) {
		<div data-kiban-filter-menu class="absolute left-0 top-[calc(100%+6px)] z-[35] flex max-h-[min(440px,calc(100vh-200px))] w-80 max-w-[calc(100vw-32px)] flex-col overflow-hidden rounded-xl bg-white shadow-[0_20px_48px_-18px_rgba(26,32,53,0.35),0_0_0_1px_rgba(26,32,53,0.06)]" role="group" aria-label={ f.Label }>
			if f.Search.Placeholder != "" {
				<label class="mx-2.5 mb-1 mt-2.5 flex h-[38px] shrink-0 items-center gap-2 rounded-lg border border-[#CDD3DF] px-2.5 text-[#9096A3] focus-within:border-kiban-primary focus-within:shadow-[0_0_0_3px_rgba(0,71,255,0.12)]">
					<svg class="h-[15px] w-[15px] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
					<input type="text" placeholder={ f.Search.Placeholder } aria-label={ f.Search.Placeholder } autocomplete="off" data-kiban-filter-q class="h-full min-w-0 flex-1 border-0 bg-transparent text-sm text-kiban-ink outline-none placeholder:text-[#9096A3]"/>
				</label>
			}
			if f.Note != "" {
				<p class="m-0 shrink-0 px-3.5 pb-0.5 pt-2 text-[11px] text-[#606875]">{ f.Note }</p>
			}
			<div class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-1.5">
				if len(f.Options) == 0 && f.Empty != "" {
					<div class="px-3.5 py-3.5 text-[13px] text-[#9096A3]">{ f.Empty }</div>
				}
				for _, o := range f.Options {
					<label class="flex cursor-pointer items-center gap-2.5 rounded-lg px-2.5 py-2 text-sm text-kiban-ink hover:bg-[#F4F7FF] has-[:checked]:bg-[rgba(0,71,255,0.06)] has-[:checked]:font-medium has-[:checked]:text-[#0036C4] [&[hidden]]:hidden" data-kiban-filter-opt>
						if f.Multi {
							<span class="relative inline-grid shrink-0 place-items-center">
								<input type={ f.inputType() } name={ f.Name } value={ o.Value } checked?={ o.Selected } data-label={ o.Label } class="peer m-0 h-[18px] w-[18px] cursor-pointer appearance-none rounded-[5px] border-[1.5px] border-[#CDD3DF] bg-white checked:border-kiban-primary checked:bg-kiban-primary"/>
								<svg class="pointer-events-none absolute h-2.5 w-2.5 text-white opacity-0 peer-checked:opacity-100" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 6.5 5 9l4.5-6"></path></svg>
							</span>
						} else {
							<span class="relative grid h-4 w-4 shrink-0 place-items-center">
								<input type={ f.inputType() } name={ f.Name } value={ o.Value } checked?={ o.Selected } data-label={ o.Label } class="peer absolute inset-0 m-0 cursor-pointer appearance-none"/>
								<svg class="pointer-events-none h-3.5 w-3.5 text-kiban-primary opacity-0 peer-checked:opacity-100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
							</span>
						}
						if o.Icon != nil {
							<span class="inline-flex shrink-0 items-center" aria-hidden="true">
								@o.Icon
							</span>
						}
						<span class="min-w-0 flex-1">{ o.Label }<span class="ml-1 text-[11px] font-normal text-[#9096A3] [&[hidden]]:hidden" hidden?={ o.Hint == "" }>{ o.Hint }</span></span>
						if o.HasCount {
							@count(cfg.ID, f.Name, o.Value, o.Count, false)
						}
					</label>
				}
				if f.Search.Placeholder != "" {
					<div class="px-3.5 py-3.5 text-[13px] text-[#9096A3]" data-kiban-filter-empty data-empty={ f.Search.Empty } hidden></div>
				}
			</div>
			if cfg.MenuClear != "" || (f.Multi && cfg.MenuSelectAll != "") {
				<div class="flex shrink-0 justify-between gap-2 border-t border-[#E2E5EC] bg-[#FAFBFF] px-2.5 py-2">
					if f.Multi && cfg.MenuSelectAll != "" {
						<button type="button" class="p-1 text-xs font-medium text-kiban-primary hover:underline" data-kiban-filter-all>{ cfg.MenuSelectAll }</button>
					} else {
						<span></span>
					}
					if cfg.MenuClear != "" {
						<button type="button" class="p-1 text-xs font-medium text-[#B42318] hover:underline" data-kiban-filter-none hidden?={ len(f.selected()) == 0 }>{ cfg.MenuClear }</button>
					}
				</div>
			}
		</div>
}

// numericMenu es la ventana del filtro numérico: la condición en botones
// segmentados, el valor (dos con «entre»), los atajos y el pie con «Quitar
// filtro» y «Aplicar». Lo tecleado no viaja: base.templ copia lo aplicado a
// los ocultos y los deshabilita si no hay valor.
templ numericMenu(cfg Config, f Filter, n Numeric) {
	<div
		data-kiban-filter-menu
		class="absolute left-0 top-[calc(100%+6px)] z-[35] flex w-[340px] max-w-[calc(100vw-32px)] flex-col gap-2.5 rounded-xl bg-white p-3 shadow-[0_20px_48px_-18px_rgba(26,32,53,0.35),0_0_0_1px_rgba(26,32,53,0.06)]"
		role="dialog"
		aria-label={ f.Label }
		data-kiban-filter-manual
		data-kiban-num
		data-op={ n.op() }
		data-unit={ n.Unit }
		data-max={ n.Max }
		data-and={ n.And }
		data-ph={ n.Placeholder }
		data-from={ n.From }
		data-err-number={ n.ErrNumber }
		data-err-range={ n.ErrRange }
		data-err-max={ n.ErrMax }
	>
		<input type="hidden" name={ n.OpName } value={ n.Op } disabled?={ n.Value == "" } data-kiban-num-op/>
		<input type="hidden" name={ n.Name } value={ n.Value } disabled?={ n.Value == "" } data-kiban-num-v/>
		<input type="hidden" name={ n.Name2 } value={ n.Value2 } disabled?={ n.Value == "" || n.Op != "bt" } data-kiban-num-v2/>
		<div class="grid grid-cols-4 gap-0.5 rounded-lg bg-[#F2F4F8] p-[3px]" role="group">
			for _, o := range n.Ops {
				<button
					type="button"
					class="whitespace-nowrap rounded-md px-1 py-1.5 text-xs font-medium text-[#606875] aria-pressed:bg-white aria-pressed:text-[#0036C4] aria-pressed:shadow-[0_1px_2px_rgba(26,32,53,0.12)]"
					data-kiban-num-opbtn={ o.Value }
					data-symbol={ o.Symbol }
					aria-pressed={ boolAttr(o.Value == n.op()) }
				>{ o.Label }</button>
			}
		</div>
		<div class="flex items-center gap-2">
			@numInput(n, n.Value, n.placeholder1(), "data-kiban-num-in")
			<span class="text-xs text-[#606875]" data-kiban-num-and hidden?={ n.op() != "bt" }>{ n.And }</span>
			<span class="contents [&[hidden]]:!hidden" data-kiban-num-2 hidden?={ n.op() != "bt" }>
				@numInput(n, n.Value2, n.To, "data-kiban-num-in2")
			</span>
		</div>
		<p class="-mt-1 mb-0 text-xs text-[#B42318]" data-kiban-num-err hidden></p>
		if len(n.Presets) > 0 {
			<div class="flex flex-wrap items-center gap-1.5">
				if n.PresetsLabel != "" {
					<span class="text-xs text-[#606875]">{ n.PresetsLabel }</span>
				}
				for _, p := range n.Presets {
					<button type="button" class="rounded-full border border-[#CDD3DF] bg-white px-2.5 py-1 text-xs text-[#474F66] hover:border-kiban-primary hover:bg-[#F4F7FF] hover:text-[#0036C4]" data-kiban-num-preset data-op={ p.Op } data-v={ p.Value }>{ p.Label }</button>
				}
			</div>
		}
		<div class="-mx-3 -mb-3 flex justify-between gap-2 rounded-b-xl border-t border-[#E2E5EC] bg-[#FAFBFF] px-2.5 py-2">
			if cfg.MenuClear != "" {
				<button type="button" class="p-1 text-xs font-medium text-[#B42318] hover:underline" data-kiban-num-clear hidden?={ n.Value == "" }>{ cfg.MenuClear }</button>
			}
			<span class="flex-1"></span>
			<button type="button" class="rounded-md bg-kiban-primary px-3 py-1.5 text-xs font-medium text-white hover:bg-[#0036C4]" data-kiban-num-apply>{ n.Apply }</button>
		</div>
	</div>
}

templ numInput(n Numeric, value, placeholder, marker string) {
	<span class="flex h-9 min-w-0 flex-1 items-center gap-1.5 rounded-md border border-[#CDD3DF] bg-white px-2.5 focus-within:border-kiban-primary focus-within:shadow-[0_0_0_3px_rgba(0,71,255,0.12)]">
		<input
			type="number"
			inputmode="decimal"
			min="0"
			step={ n.Step }
			if n.Max != "" {
				max={ n.Max }
			}
			value={ value }
			placeholder={ placeholder }
			aria-label={ placeholder }
			class="min-w-0 flex-1 border-0 bg-transparent text-sm tabular-nums text-kiban-ink outline-none"
			{ templ.Attributes{marker: true}... }
		/>
		if n.Unit != "" {
			<span class="text-xs text-[#9096A3]">{ n.Unit }</span>
		}
	</span>
}

// count es el número de una opción. Con oob, Counts lo manda solo para que
// htmx reemplace el de la barra (que no se vuelve a pintar).
templ count(formID, filter, value string, n int, oob bool) {
	<span id={ countID(formID, filter, value) } class="text-xs tabular-nums text-[#9096A3]" data-kiban-filter-count if oob { hx-swap-oob="true" }>{ strconv.Itoa(n) }</span>
}

// Counts son los conteos de todas las opciones (las que llevan HasCount)
// para una respuesta parcial: la tabla cambia y los números de los menús se
// ponen al día sin pintar otra vez la barra.
templ Counts(cfg Config) {
	for _, f := range cfg.Filters {
		for _, o := range f.Options {
			if o.HasCount {
				@count(cfg.ID, f.Name, o.Value, o.Count, true)
			}
		}
	}
}

// pillText es el texto inicial de la píldora; después lo mantiene el
// navegador con la misma regla.
templ pillText(f Filter) {
	if f.Numeric != nil && f.Numeric.Value != "" {
		{ f.Label + ": " }<b class="font-semibold">{ f.Numeric.text() }</b>
	} else if f.Numeric != nil {
		{ f.Label }
	} else {
		@optionsPillText(f)
	}
}

templ optionsPillText(f Filter) {
	switch sel := f.selected(); len(sel) {
		case 0:
			{ f.Label }
		case 1:
			{ f.Label + ": " }<b class="font-semibold">{ sel[0].Label }</b>
		default:
			{ f.Label + " " }<b class="font-semibold">{ "· " + strconv.Itoa(len(sel)) }</b>
	}
}

// State son los campos ocultos de la barra (Hidden) en un contenedor con id.
// La barra no se vuelve a pintar al filtrar, así que cuando el orden o las
// filas por página cambian desde la tabla, la respuesta trae State con
// oob=true y htmx lo reemplaza dentro del form (hx-swap-oob).
templ State(cfg Config, oob bool) {
	<div id={ cfg.ID + "-state" } hidden if oob { hx-swap-oob="true" }>
		for _, h := range cfg.Hidden {
			<input type="hidden" name={ h.Name } value={ h.Value }/>
		}
	</div>
}
