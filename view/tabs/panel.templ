package tabs

import (
	"strconv"

	"github.com/kiban-cloud/go-kiban-design-system/view/flamboyant"
)

// Panel renders a tab-panel container: header strip on top, body
// area below, with CSS-only switching driven by the parent's
// `data-kiban-tabs-active-key` attribute. Tab bodies are passed
// as templ children via `Body(key)` calls inside the Panel block.
//
// Wiring (lives in view/layout/base.templ):
//   - Clicking a `[data-kiban-tabs-tab]` button updates the
//     ancestor `[data-kiban-tabs-panel]`'s `data-kiban-tabs-active-key`
//     attribute. CSS rules then show only the matching
//     `[data-kiban-tabs-body]` and apply the active-tab styling
//     to the matching tab button.
//   - Multiple Panels on the same page coexist via the wrapping
//     panel selector — handlers never reach outside their panel.
//
// Empty Tabs renders just the body container (no strip), so a
// degenerate one-tab UI can still pass through Panel without
// adding visual chrome.
templ Panel(cfg PanelConfig) {
	<section
		id={ cfg.ID }
		data-kiban-tabs-panel
		data-kiban-tabs-active-key={ cfg.ActiveKey }
		class={ "bg-white border", templ.KV("border-kiban-border rounded-md", !flamboyant.On(ctx)), templ.KV("border-[#E2E5EC] rounded-[10px] px-5 pb-5 pt-1", flamboyant.On(ctx)) }
	>
		if flamboyant.On(ctx) {
			if len(cfg.Tabs) > 0 {
				@flamboyantStrip(cfg.Tabs)
			}
			<div class="pt-5">
				{ children... }
			</div>
		} else {
			if len(cfg.Tabs) > 0 {
				@strip(cfg.Tabs)
			}
			<div class="p-5 space-y-4">
				{ children... }
			</div>
		}
	</section>
}

// strip renders the tab header buttons. Active state is purely
// CSS-driven (see base.templ rules); the buttons just carry their
// keys + the data-kiban-tabs-tab marker so the global handler
// recognises them.
templ strip(tabs []TabHeader) {
	<div class="border-b border-kiban-border px-5 pt-4">
		<nav class="-mb-px flex gap-3 flex-wrap" role="tablist">
			for _, t := range tabs {
				<button
					type="button"
					role="tab"
					data-kiban-tabs-tab
					data-kiban-tabs-key={ t.Key }
					class="px-3 py-2 text-sm transition-colors border-b"
				>
					<span class="inline-flex items-center gap-1.5">
						if t.Icon != nil {
							@t.Icon
						}
						<span>{ t.Label }</span>
						if t.HasError {
							<span aria-hidden="true" class="inline-block w-1.5 h-1.5 rounded-full bg-red-500"></span>
						}
					</span>
				</button>
			}
		</nav>
	</div>
}

// flamboyantStrip es la tira de kiban-proto: subrayado bajo el label, ícono
// en el color del módulo y contador en píldora, ambos sólo en la pestaña
// activa. El estado activo lo da [data-kiban-tabs-active] en el botón
// (base.templ), que las clases leen con group-data. El ícono lleva abajo el
// mismo espacio que el subrayado del label (pb-2 + 1 px de borde) para
// quedar centrado con el texto y no con la etiqueta entera.
templ flamboyantStrip(tabs []TabHeader) {
	<div class="border-b border-kiban-border">
		<nav class="-mb-px flex gap-5 overflow-x-auto" role="tablist">
			for _, t := range tabs {
				<button
					type="button"
					role="tab"
					data-kiban-tabs-tab
					data-kiban-tabs-key={ t.Key }
					class="group/tab inline-flex shrink-0 items-center gap-2 whitespace-nowrap pt-2 text-sm transition-colors"
				>
					if t.Icon != nil {
						<span class={ "mb-[9px] inline-flex [&>svg]:h-[15px] [&>svg]:w-[15px]", tabIconActiveClass(t.IconColor) }>
							@t.Icon
						</span>
					}
					<span class="inline-block border-b border-transparent pb-2 group-data-[kiban-tabs-active]/tab:border-kiban-primary">{ t.Label }</span>
					if t.HasCount {
						<span class="mb-2 inline-flex items-center rounded-full bg-kiban-surface px-2 py-0.5 text-xs text-kiban-ink3 group-data-[kiban-tabs-active]/tab:bg-kiban-primary-soft group-data-[kiban-tabs-active]/tab:text-kiban-primary">{ strconv.Itoa(t.Count) }</span>
					}
					if t.HasError {
						<span aria-hidden="true" class="mb-2 inline-block h-1.5 w-1.5 rounded-full bg-red-500"></span>
					}
				</button>
			}
		</nav>
	</div>
}

// Body wraps one tab's content. Each Body inside a Panel block
// declares its key via `data-kiban-tabs-key`; the panel-level
// CSS shows only the body whose key matches the parent's active
// key. Multiple Bodies with the same key would all show together
// — but Panel renders each tab once by construction, so this is
// a non-issue for the canonical usage.
templ Body(key string) {
	<div data-kiban-tabs-body data-kiban-tabs-key={ key }>
		{ children... }
	</div>
}
