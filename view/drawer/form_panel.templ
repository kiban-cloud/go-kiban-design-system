package drawer

import "github.com/kiban-cloud/go-kiban-design-system/view/button"

// FormPanel es el panel de formulario flamboyant (ver FormPanelConfig).
// children es el cuerpo: las tarjetas del formulario.
templ FormPanel(cfg FormPanelConfig) {
	<div
		id={ cfg.ID }
		class="fixed inset-0 z-[45] text-kiban-ink"
		data-kiban-panel
		data-close-href={ cfg.CloseHref }
		data-standalone?={ cfg.Standalone }
		role="presentation"
	>
		<div class="absolute inset-0 bg-[rgba(244,247,255,0.55)] backdrop-blur-[6px] backdrop-saturate-[.6]" data-kiban-panel-close></div>
		<form
			class={
				"absolute inset-y-0 right-0 m-0 flex flex-col bg-white shadow-[-16px_0_40px_-20px_rgba(26,32,53,0.45)]",
				templ.KV("w-1/2 max-[1100px]:w-screen", cfg.Half),
				templ.KV("w-[95vw] max-sm:w-screen", !cfg.Half),
				templ.KV("animate-[kiban-panel-in_.2s_ease-out]", !cfg.Static),
			}
			role="dialog"
			aria-modal="true"
			aria-labelledby={ cfg.ID + "-title" }
			{ cfg.FormAttrs... }
		>
			@panelHeader(cfg.header())
			<div class="flex-1 overflow-auto bg-[#F4F7FF] px-6 pb-7 pt-5 max-sm:p-4 [&_.border-kiban-border]:border-[#CDD3DF] [&_.text-red-500]:text-[#B42318] [&_label.text-xs]:text-[#474F66] [&_textarea]:rounded-lg [&_textarea:focus]:border-kiban-primary [&_textarea:focus]:shadow-[0_0_0_3px_rgba(0,71,255,0.12)] [&_select:focus]:border-kiban-primary [&_select:focus]:shadow-[0_0_0_3px_rgba(0,71,255,0.12)] [&_input:not([type=checkbox]):not([type=radio]):focus]:border-kiban-primary">
				{ children... }
			</div>
			<div class="flex min-h-[60px] flex-wrap items-center gap-3 border-t border-kiban-border bg-white px-5 py-3">
				if cfg.FooterLeft != nil {
					@cfg.FooterLeft
				}
				<div class="min-w-0 flex-1 text-[13px] text-[#606875]" data-kiban-panel-sum data-pending={ cfg.SummaryPending } data-ready={ cfg.SummaryReady } data-clean={ cfg.SummaryClean }>{ cfg.summaryInitial() }</div>
				<div class="flex shrink-0 gap-2 max-sm:w-full [&>*]:max-sm:flex-1">
					for _, a := range cfg.Actions.SecondaryActions {
						@button.Button(button.WithDefaultVariant(a, "secondary"))
					}
					if cfg.PrimarySplit != nil {
						@button.Split(*cfg.PrimarySplit)
					} else if cfg.Actions.PrimaryAction != nil {
						@button.Button(button.WithDefaultVariant(*cfg.Actions.PrimaryAction, "primary"))
					}
				</div>
			</div>
		</form>
		if cfg.Guard != nil {
			<div class="absolute inset-0 z-[5] flex items-center justify-center bg-[rgba(26,32,53,0.3)] p-4 [&[hidden]]:hidden" data-kiban-panel-guard hidden>
				<div class="w-[min(540px,calc(100%-32px))] rounded-xl bg-white p-6 shadow-[0_24px_60px_-20px_rgba(26,32,53,0.5)]" role="alertdialog" aria-modal="true" aria-labelledby={ cfg.ID + "-guard-title" }>
					<div class="flex items-start gap-3">
						<span class="grid h-9 w-9 shrink-0 place-items-center rounded-[10px] bg-[#F3EAFF] text-[#6A00D6]">
							<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
						</span>
						<div>
							<h2 id={ cfg.ID + "-guard-title" } class="mb-1.5 mt-[7px] text-base font-medium leading-[22px]">{ cfg.Guard.Title }</h2>
							<p class="m-0 text-[13px] leading-normal text-[#606875]">{ cfg.Guard.Text }</p>
						</div>
					</div>
					<div class="ml-12 mt-5 flex items-center justify-end gap-2 border-t border-[#E2E5EC] pt-4 max-[520px]:ml-0 max-[520px]:flex-wrap">
						@button.Button(button.Options{Label: cfg.Guard.Discard, Variant: "danger-outline", ExtraClass: "mr-auto max-[520px]:order-3 max-[520px]:mr-0 max-[520px]:w-full", Attrs: templ.Attributes{"data-kiban-guard-discard": ""}})
						@button.Button(button.Options{Label: cfg.Guard.Stay, Variant: "secondary", ExtraClass: "max-[520px]:w-full", Attrs: templ.Attributes{"data-kiban-guard-stay": ""}})
						@button.Button(button.Options{Label: cfg.Guard.SaveClose, Variant: "primary", ExtraClass: "max-[520px]:w-full", Attrs: templ.Attributes{"data-kiban-guard-save": ""}})
					</div>
				</div>
			</div>
		}
	</div>
}

// panelHeader es el encabezado común de FormPanel y ViewPanel: ícono,
// antetítulo, título (en vivo si hay TitleFrom), subtítulo, acciones y cerrar.
templ panelHeader(h panelHead) {
	<div class="flex min-h-16 items-center gap-3 border-b border-kiban-border px-5 py-3">
		<div class="flex min-w-0 flex-1 items-center gap-3">
			if h.Tile != nil {
				@h.Tile
			}
			<div class="min-w-0 flex-1">
				if h.TitleInput != nil {
					<label for={ h.ID + "-title" } class="block text-[11px] font-semibold uppercase tracking-[.06em] text-[#9096A3]">{ h.Eyebrow }</label>
					<input
						id={ h.ID + "-title" }
						name={ h.TitleInput.Name }
						value={ h.TitleInput.Value }
						placeholder={ h.TitleInput.Placeholder }
						required?={ h.TitleInput.Required }
						if h.TitleInput.Help != "" {
							aria-describedby={ h.ID + "-title-help" }
						}
						autocomplete="off"
						class="-ml-[7px] block w-full max-w-[640px] rounded-md border border-transparent bg-transparent px-1.5 py-0.5 text-[17px] font-medium leading-6 text-kiban-ink placeholder:font-normal placeholder:text-[#9096A3] hover:border-[#E2E5EC] focus:border-kiban-primary focus:outline-none [&:user-invalid]:border-[#F3A6A6]"
					/>
					if h.TitleInput.Help != "" {
						<span id={ h.ID + "-title-help" } class="sr-only">{ h.TitleInput.Help }</span>
					}
				} else {
					<div class="text-[11px] font-semibold uppercase tracking-[.06em] text-[#9096A3]">{ h.Eyebrow }</div>
					<div
						id={ h.ID + "-title" }
						class="truncate text-[17px] font-medium leading-6 data-[empty]:font-normal data-[empty]:text-[#9096A3]"
						data-kiban-panel-title
						data-from={ h.titleFrom() }
						data-placeholder={ h.TitlePlaceholder }
						data-empty?={ h.Title == "" }
					>{ h.titleText() }</div>
				}
				if h.Subtitle != nil {
					<div class="mt-0.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[#606875]">
						@h.Subtitle
					</div>
				}
			</div>
		</div>
		<div class="flex items-center gap-2">
			if h.Dirty != "" {
				<span class="hidden whitespace-nowrap text-xs text-[#6A00D6] [[data-dirty]_&]:inline" data-kiban-panel-dirty><span aria-hidden="true">● </span>{ h.Dirty }</span>
			}
			if h.HeaderActions != nil {
				@h.HeaderActions
			}
			@button.Button(button.Options{Variant: "icon", Icon: "close", AriaLabel: h.CloseLabel, Attrs: templ.Attributes{"data-kiban-panel-close": ""}})
		</div>
	</div>
}

// ViewPanel es el panel de consulta flamboyant (la ficha del cliente): mismo
// encabezado y comportamiento de cierre que FormPanel, sin form ni pie. Se
// pinta abierto; children es el cuerpo.
templ ViewPanel(cfg ViewPanelConfig) {
	<div
		id={ cfg.ID }
		class="fixed inset-0 z-[45] text-kiban-ink"
		data-kiban-panel
		data-close-href={ cfg.CloseHref }
		data-standalone?={ cfg.Standalone }
		role="presentation"
	>
		<div class="absolute inset-0 bg-[rgba(244,247,255,0.55)] backdrop-blur-[6px] backdrop-saturate-[.6]" data-kiban-panel-close></div>
		<div
			class={
				"absolute inset-y-0 right-0 flex flex-col bg-white shadow-[-16px_0_40px_-20px_rgba(26,32,53,0.45)]",
				templ.KV("w-1/2 max-[1100px]:w-screen", cfg.Half),
				templ.KV("w-[95vw] max-sm:w-screen", !cfg.Half),
				templ.KV("animate-[kiban-panel-in_.2s_ease-out]", !cfg.Static),
			}
			role="dialog"
			aria-modal="true"
			aria-labelledby={ cfg.ID + "-title" }
		>
			@panelHeader(cfg.header())
			<div class="flex-1 overflow-auto bg-[#F4F7FF] px-6 pb-7 pt-5 max-sm:p-4">
				{ children... }
			</div>
		</div>
	</div>
}
