package drawer

import "github.com/kiban-cloud/go-kiban-design-system/view/icons"

// Confirm is a fixed-shape Modal preset for "are you sure?" prompts that
// need richer markup than HTMX's native `hx-confirm` (which is just the
// browser's blocking confirm dialog). Use Confirm when:
//
//   - You want a styled modal that matches the kiban look-and-feel.
//   - The destructive action needs HTMX wiring on the confirm button
//     (hx-post / hx-target / hx-swap / hx-indicator).
//   - You want a custom title or a longer message.
//
// Use HTMX's native `hx-confirm="…"` (no Confirm component) when:
//
//   - The action is one-line, "Sure?"-level confirmation.
//   - You don't need styling — the browser's native dialog is fine.
//
// Layout: title (optional) → message → actions (cancel left, confirm
// right). PrimaryAction is rendered as the right button — set
// `Variant: "danger"` for destructive actions (red background) or leave
// empty / "primary" for non-destructive proceed prompts. Cancel is
// always a button that closes the overlay; its label defaults to
// "Cancelar" when SecondaryActionLabel is empty.
//
// Open / close: same JS helpers and Escape behaviour as SidePanel /
// Modal. Trigger from the call site with
// `onclick="kibanOpenOverlay('the-id')"`.
//
// Size defaults to "sm" (max-w-sm) — confirmations are tighter than
// general modals.
templ Confirm(cfg ConfirmConfig) {
	<div data-kiban-overlay id={ cfg.ID } class="hidden fixed inset-0 z-50 flex items-center justify-center">
		<div { overlayBackdropAttrs(cfg.ID, "bg-black/40")... }></div>
		<div
			class={
				"relative bg-white rounded-md shadow-xl w-full mx-4",
				confirmSizeClass(cfg.Size),
			}
		>
			if cfg.Title != "" {
				<div class="px-6 py-4 border-b border-kiban-border flex items-center justify-between">
					<div class="font-heading font-medium text-lg">{ cfg.Title }</div>
					<button { overlayCloseAttrs(cfg.ID)... }>
						@icons.Close()
					</button>
				</div>
			}
			<div class="px-6 py-5">
				<p class="text-sm text-kiban-ink2">{ cfg.Message }</p>
			</div>
			<div class="px-6 py-4 border-t border-kiban-border flex gap-3 justify-end shrink-0">
				@renderAction(Action{
					Label:   confirmCancelLabel(cfg.SecondaryActionLabel),
					Variant: "secondary",
					OnClick: "kibanCloseOverlay('" + cfg.ID + "')",
				}, "secondary")
				@renderAction(cfg.PrimaryAction, "primary")
			</div>
		</div>
	</div>
}
