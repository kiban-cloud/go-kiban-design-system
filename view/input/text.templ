package input

// Text renders a labelled `<input type="text">` with optional error and hint
// states. Layout is a vertical stack: label (with optional required asterisk)
// → input → either the error message (red) or the hint (muted), never both.
//
// The border swaps from kiban-border/kiban-primary to red-400/red-500 when
// errMsg is non-empty, so the error state is visible both at rest and on
// focus. Pass hint="" to omit the helper text entirely.
templ Text(name, label, value, errMsg, hint string, required bool) {
	<div class="space-y-1">
		if label != "" {
			<label for={ "f-" + name } class="text-xs font-medium text-kiban-ink2">
				{ label }
				if required {
					<span class="text-red-500 ml-0.5">*</span>
				}
			</label>
		}
		<input
			id={ "f-" + name }
			type="text"
			name={ name }
			value={ value }
			class={
				"w-full border rounded-md px-3 py-2 text-sm focus:outline-none",
				templ.KV("border-kiban-border focus:border-kiban-primary", errMsg == ""),
				templ.KV("border-red-400 focus:border-red-500", errMsg != ""),
			}
		/>
		if errMsg != "" {
			<div class="text-xs text-red-600">{ errMsg }</div>
		} else if hint != "" {
			<div class="text-xs text-kiban-ink3">{ hint }</div>
		}
	</div>
}
