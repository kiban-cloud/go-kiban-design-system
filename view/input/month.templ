package input

// Month renders a labelled `<input type="month">`. The browser supplies a
// month-only picker (no day); the form value is the HTML5 month string
// "YYYY-MM". Same label / error / hint contract as Text and Date.
//
// Browser support is ubiquitous in evergreen browsers (Chrome, Edge,
// Safari, Firefox); older browsers fall back to a free-form text
// input — server-side parsers should validate the YYYY-MM shape
// regardless.
templ Month(name, label, value, errMsg, hint string, required bool) {
	<div class="space-y-1">
		if label != "" {
			<label for={ "f-" + name } class="text-xs font-medium text-kiban-ink2">
				{ label }
				if required {
					<span class="text-red-500 ml-0.5">*</span>
				}
			</label>
		}
		<input
			id={ "f-" + name }
			type="month"
			name={ name }
			value={ value }
			class={
				"w-full border rounded-md px-3 py-2 text-sm focus:outline-none",
				templ.KV("border-kiban-border focus:border-kiban-primary", errMsg == ""),
				templ.KV("border-red-400 focus:border-red-500", errMsg != ""),
			}
		/>
		if errMsg != "" {
			<div class="text-xs text-red-600">{ errMsg }</div>
		} else if hint != "" {
			<div class="text-xs text-kiban-ink3">{ hint }</div>
		}
	</div>
}
