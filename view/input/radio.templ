package input

import "github.com/kiban-cloud/go-kiban-design-system/view/flamboyant"

// RadioCard is the kiban "card-style radio button": a bordered, clickable
// label that wraps a native `<input type="radio">` and a title + optional
// subtitle block. The whole card highlights when checked
// (border-kiban-primary + bg-kiban-primary-soft) so the selected state is
// obvious without relying on the small native radio glyph alone.
//
// Several cards share the same `name` to form a group; submitting picks the
// `value` of whichever card is checked. `attrs` is the HTMX escape hatch:
// projects that want a partial re-render on selection change (e.g. the
// PF/PM toggle on the customers form) pass hx-post / hx-target / hx-swap
// here without the design system having to know about HTMX.
//
// Visual contract: the label carries `data-kiban-radio-card` and CSS in
// `view/layout/base.templ` paints the highlight via `:has(input:checked)`,
// so the selected look follows the *real* state of the native input — not
// the server-rendered `checked` bool. This matters for HTMX flows where
// the radio is clicked but the card itself is not re-rendered (e.g. the
// trigger only swaps a different region). Without the CSS the highlight
// would stay stuck on whichever option was originally checked at server
// render time.
templ RadioCard(name, value, title, subtitle string, checked bool, attrs templ.Attributes) {
	@RadioCardWith(RadioCardOptions{Name: name, Value: value, Title: title, Subtitle: subtitle, Checked: checked, Attrs: attrs})
}

// RadioCardWith es RadioCard con opciones: en flamboyant, un ícono en un
// cuadro de color (Icon, Tone "success" verde o vacío azul) y la tarjeta
// marcada en azul. Con el diseño de siempre el ícono no se muestra.
templ RadioCardWith(o RadioCardOptions) {
	if flamboyant.On(ctx) {
		<label
			data-kiban-radio-card
			class={
				"relative grid cursor-pointer gap-2.5 rounded-lg border border-[#CDD3DF] bg-white hover:bg-[#F4F7FF] has-[:checked]:border-kiban-primary has-[:checked]:bg-[rgba(0,71,255,0.08)] has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-1 has-[:focus-visible]:outline-kiban-primary",
				templ.KV("grid-cols-[36px_minmax(0,1fr)] items-center px-3 py-2.5", !o.Big),
				templ.KV("grid-cols-[40px_minmax(0,1fr)] items-start p-3", o.Big),
			}
		>
			<input type="radio" name={ o.Name } value={ o.Value } checked?={ o.Checked } class="pointer-events-none absolute opacity-0" { o.Attrs... }/>
			<span class={ "grid h-9 w-9 place-items-center rounded-lg", templ.KV("bg-[#E3FBF5] text-[#007A63]", o.Tone == "success"), templ.KV("bg-[#F2F2F2] text-[#474747]", o.Tone == "neutral"), templ.KV("bg-[#EAF0FF] text-[#0036C4]", o.Tone != "success" && o.Tone != "neutral") }>
				if o.Icon != nil {
					@o.Icon
				}
			</span>
			<span class="min-w-0">
				<b class="block text-sm font-medium leading-[18px] text-kiban-ink">{ o.Title }</b>
				if o.Subtitle != "" {
					<small class="block text-xs leading-4 text-[#606875]">{ o.Subtitle }</small>
				}
				if len(o.Tags) > 0 {
					<span class="mt-1 flex flex-wrap gap-1">
						for _, t := range o.Tags {
							<span class="rounded-full bg-[#F2F4F8] px-2 py-px text-[11px] text-[#474F66]">{ t }</span>
						}
					</span>
				}
			</span>
		</label>
	} else {
		@classicRadioCard(o.Name, o.Value, o.Title, o.Subtitle, o.Checked, o.Attrs)
	}
}

templ classicRadioCard(name, value, title, subtitle string, checked bool, attrs templ.Attributes) {
	<label
		data-kiban-radio-card
		class="border border-kiban-border rounded-md px-4 py-3 cursor-pointer flex items-center gap-3 hover:border-kiban-ink3"
	>
		<input
			type="radio"
			name={ name }
			value={ value }
			checked?={ checked }
			class="cursor-pointer"
			{ attrs... }
		/>
		<div>
			<div class="text-sm font-medium text-kiban-ink">{ title }</div>
			if subtitle != "" {
				<div class="text-xs text-kiban-ink3">{ subtitle }</div>
			}
		</div>
	</label>
}
