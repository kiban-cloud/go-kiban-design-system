package input

// Password renders a labelled `<input type="password">` with `autocomplete="off"`
// baked in. Same label / error / hint contract as Text, plus a `placeholder`
// parameter — used in the kiban backoffice to render the "••••••••" sentinel
// when the field is already configured server-side and the user can leave it
// blank to keep the current secret. Pass placeholder="" when there is no
// stored value yet.
//
// `value` is intentionally still surfaced (instead of always "" inside the
// component) so the caller decides whether to round-trip what the user typed
// on a validation re-render. For "never echo the secret back" flows the
// caller passes "" — the placeholder communicates "leave blank to keep".
templ Password(name, label, value, errMsg, hint string, required bool, placeholder string) {
	<div class="space-y-1">
		if label != "" {
			<label for={ "f-" + name } class="text-xs font-medium text-kiban-ink2">
				{ label }
				if required {
					<span class="text-red-500 ml-0.5">*</span>
				}
			</label>
		}
		<input
			id={ "f-" + name }
			type="password"
			name={ name }
			value={ value }
			autocomplete="off"
			placeholder={ placeholder }
			class={
				"w-full border rounded-md px-3 py-2 text-sm focus:outline-none",
				templ.KV("border-kiban-border focus:border-kiban-primary", errMsg == ""),
				templ.KV("border-red-400 focus:border-red-500", errMsg != ""),
			}
		/>
		if errMsg != "" {
			<div class="text-xs text-red-600">{ errMsg }</div>
		} else if hint != "" {
			<div class="text-xs text-kiban-ink3">{ hint }</div>
		}
	</div>
}
