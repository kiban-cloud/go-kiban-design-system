package input

// Hidden emits a single `<input type="hidden">` with no surrounding markup.
// Used for context fields the form needs to round-trip (entity id on edit,
// pagination cursors, lat/long captured by JS, etc.) — the value never
// renders to the user.
//
// `id` is optional. Most hiddens don't need one (the backend reads them by
// `name`), but pass a non-empty `id` when JS needs to read or write the
// value at runtime — e.g. geolocation scripts that fill lat/lng before
// submit. When `id` is empty, the attribute renders as empty but is
// harmless; keep it set when you actually need DOM access.
templ Hidden(name, value, id string) {
	<input type="hidden" id={ id } name={ name } value={ value }/>
}
