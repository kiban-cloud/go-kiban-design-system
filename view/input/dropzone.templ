package input

// Dropzone es la zona para soltar un archivo de flamboyant (carga masiva):
// el input cubre la zona entera, así que arrastrar y soltar o hacer clic
// eligen el archivo sin JS propio. Al elegirlo, base.templ escribe su nombre
// y tamaño en la zona ([data-kiban-dropzone]).
templ Dropzone(o DropzoneOptions) {
	<label class="relative flex cursor-pointer flex-col items-center gap-2 rounded-lg border border-dashed border-[#9DB4FF] bg-white px-4 py-7 text-center transition-colors hover:bg-[#F4F7FF] has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-kiban-primary" data-kiban-dropzone>
		<input type="file" name={ o.Name } accept={ o.Accept } required?={ o.Required } class="absolute inset-0 cursor-pointer opacity-0"/>
		<span class="grid h-10 w-10 place-items-center rounded-full bg-[#EAF0FF] text-[#0036C4]">
			<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
		</span>
		<span class="text-sm font-medium text-kiban-ink" data-kiban-dropzone-title>{ o.Title }</span>
		if o.Hint != "" {
			<span class="text-xs text-kiban-ink3">{ o.Hint }</span>
		}
		<span class="hidden text-sm font-medium text-kiban-primary" data-kiban-dropzone-file></span>
	</label>
}
