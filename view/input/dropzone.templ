package input

// Dropzone es la zona para soltar archivos de flamboyant (carga masiva, una
// entrega de klin con Multiple):
// el input cubre la zona entera, así que arrastrar y soltar o hacer clic
// eligen el archivo sin JS propio. Al elegirlo, base.templ escribe su nombre
// y tamaño en la zona ([data-kiban-dropzone]). Con Change, la zona se pinta
// en verde y el nombre reemplaza a la invitación (las capturas del proto). Con
// Multiple, cuántos archivos son y sus nombres.
templ Dropzone(o DropzoneOptions) {
	<label
		class={ "relative flex cursor-pointer flex-col items-center justify-center gap-2 rounded-lg border border-dashed border-[#9DB4FF] bg-white px-4 py-7 text-center transition-colors hover:bg-[#F4F7FF] has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-kiban-primary data-[has-file]:border-solid data-[has-file]:border-[#00B894] data-[has-file]:bg-[#F2FDFA]", templ.KV("min-h-[150px]", o.Tall) }
		data-kiban-dropzone
		if o.Change != "" {
			data-change={ o.Change }
		}
	>
		<input type="file" name={ o.Name } accept={ o.Accept } required?={ o.Required } multiple?={ o.Multiple } class="absolute inset-0 cursor-pointer opacity-0"/>
		<span class="grid h-10 w-10 place-items-center rounded-full bg-[#EAF0FF] text-[#0036C4]" data-kiban-dropzone-icon>
			if o.Image {
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
			} else {
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" x2="12" y1="3" y2="15"></line></svg>
			}
		</span>
		if o.Image {
			<img class="hidden max-h-[110px] max-w-full rounded-md border border-[#E2E5EC] object-contain" alt="" data-kiban-dropzone-thumb/>
		}
		if o.Pick != "" {
			<span class="text-[13px] text-kiban-ink" data-kiban-dropzone-title><b class="font-medium">{ o.Title }</b> { o.Or } <span class="font-medium text-kiban-primary">{ o.Pick }</span></span>
		} else {
			<span class="text-sm font-medium text-kiban-ink" data-kiban-dropzone-title>{ o.Title }</span>
		}
		if o.Hint != "" {
			<span class="text-xs text-kiban-ink3" data-kiban-dropzone-hint>{ o.Hint }</span>
		}
		<span class="hidden max-w-full break-words text-sm font-medium text-kiban-primary" data-kiban-dropzone-file></span>
	</label>
}
